# TurboEdge-DE Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For Gmail:
#   1. Enable 2-Step Verification on your Google account
#   2. Generate an App Password (not your regular Gmail password)
#   3. Use that 16-character App Password below

# Gmail SMTP Credentials
# Leave blank for dry-run mode (no emails sent, logged instead)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Recipient email for trade alerts, health reports, errors
# Comma-separated for multiple recipients
TURBOEDGE_EMAIL_TO=user@example.com,alerts@example.com

# Configuration and state directories
# Defaults: ./configs and ./state
TURBOEDGE_CONFIG_DIR=./configs
TURBOEDGE_STATE_DIR=./state

# Logging output format: "console" or "json"
# "console" = human-readable terminal output with colors
# "json" = machine-readable structured logs (for aggregation)
TURBOEDGE_LOG_FORMAT=console

# Optional: Python logging level
# DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO
# TURBOEDGE_LOG_LEVEL=INFO
