# TurboEdge-DE Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For Gmail:
#   1. Enable 2-Step Verification on your Google account
#   2. Generate an App Password (not your regular Gmail password)
#   3. Use that 16-character App Password below

# Gmail SMTP Credentials
# Leave blank for dry-run mode (no emails sent, logged instead)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Recipient email for trade alerts, health reports, errors
# Comma-separated for multiple recipients
TURBOEDGE_EMAIL_TO=user@example.com,alerts@example.com

# Configuration and state directories
# Defaults: ./configs and ./state
TURBOEDGE_CONFIG_DIR=./configs
TURBOEDGE_STATE_DIR=./state

# Logging output format: "console" or "json"
# "console" = human-readable terminal output with colors
# "json" = machine-readable structured logs (for aggregation)
TURBOEDGE_LOG_FORMAT=console

# Optional: Python logging level
# DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO
# TURBOEDGE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# External Data Factory credentials
#
# Both are optional. A source whose variable is unset is reported as
# AUTH_MISSING and is never fetched -- it is skipped cleanly, not attempted
# and failed. Nothing in TurboEdge ever writes a credential to the database,
# to a log line or into an archived request fingerprint.
#
# In CI these belong in GitHub repository secrets, not in a file:
#   gh secret set FRED_API_KEY
#   gh secret set ESTAT_APP_ID
# ---------------------------------------------------------------------------

# FRED / ALFRED (Federal Reserve Bank of St. Louis). Free.
# Register at https://fredaccount.stlouisfed.org/apikeys
# ALFRED vintage support is what makes this the only Wave 1 source whose
# history is genuinely point-in-time safe.
FRED_API_KEY=

# e-Stat (Portal Site of Official Statistics of Japan). Free.
# Register at https://www.e-stat.go.jp/api/ -- the credential is called an
# "application ID" rather than an API key.
ESTAT_APP_ID=
